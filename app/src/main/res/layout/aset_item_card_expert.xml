<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="20dp"

        android:background="@drawable/frame_home"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatarExpert"
            android:layout_width="80dp"
            android:layout_height="80dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"


            android:src="@drawable/mood1"
            app:shapeAppearanceOverlay="@style/CircleStyle"

            />

        <TextView
            android:id="@+id/txtUsernmae"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toTopOf="@id/avatarExpert"
            app:layout_constraintStart_toEndOf="@id/avatarExpert"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="20dp"

            android:text="Dr. Agha"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/default_blue"
            />
        <TextView
            android:id="@+id/txtJob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toBottomOf="@id/txtUsernmae"
            app:layout_constraintStart_toStartOf="@id/txtUsernmae"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="20dp"

            android:text="Psikolog"
            android:textColor="#616B7E"
            android:textSize="12sp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>