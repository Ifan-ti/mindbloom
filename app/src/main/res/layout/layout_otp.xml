<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="24dp"
    >

    <ImageView
        android:id="@+id/logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp"
        android:src="@drawable/icon_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </ImageView>


    <TextView
        android:id="@+id/txt_signup_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Sign in"
        android:textColor="@color/black"


        app:layout_constraintTop_toBottomOf="@id/logo"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:id="@+id/txt_signup_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="Welcome in"
        android:textColor="@color/black"

        app:layout_constraintTop_toBottomOf="@id/txt_signup_top"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <EditText
        android:id="@+id/input_1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"

        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/input_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />

    <EditText
        android:id="@+id/input_2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"

        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        app:layout_constraintStart_toEndOf="@+id/input_1"
        app:layout_constraintEnd_toStartOf="@+id/input_3" />

    <EditText

        android:id="@+id/input_3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        android:background="@drawable/bg_input_otp"

        android:layout_marginTop="10dp"
        app:layout_constraintStart_toEndOf="@+id/input_2"
        app:layout_constraintEnd_toStartOf="@+id/input_4" />

    <EditText
        android:id="@+id/input_4"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        android:background="@drawable/bg_input_otp"

        android:layout_marginTop="10dp"
        app:layout_constraintStart_toEndOf="@+id/input_3"
        app:layout_constraintEnd_toStartOf="@+id/input_5" />

    <EditText
        android:id="@+id/input_5"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"

        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toEndOf="@+id/input_4"
        />

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_regular"

        app:layout_constraintTop_toBottomOf="@id/input_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        />
    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_regular"

        android:gravity="center"
        android:text="@string/info"
        android:textColor="#757575"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnContinue"
        />
</androidx.constraintlayout.widget.ConstraintLayout>