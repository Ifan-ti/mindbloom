<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/inactive_light_blue"
    >

    <ImageView
        android:id="@+id/logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp"
        android:src="@drawable/icon_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </ImageView>


    <TextView
        android:id="@+id/txt_signup_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Sign in"
        android:textColor="@color/black"


        app:layout_constraintTop_toBottomOf="@id/logo"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
    </TextView>
    <TextView
        android:id="@+id/txt_signup_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="Welcome in"
        android:textColor="@color/black"

        app:layout_constraintTop_toBottomOf="@id/txt_signup_top"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
    </TextView>

    <EditText
        android:id="@+id/EmailInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"

        android:fontFamily="@font/poppins_regular"
        android:hint="Email@gmail.com"
        android:inputType="textEmailAddress"
        android:background="@drawable/bg_input_otp"
        android:textColorHint="@color/default_blue"
        android:textColor="@color/default_blue"
        android:textSize="16sp"
        android:padding="10dp"

        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        >

    </EditText>
    <EditText
        android:id="@+id/PasswordInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:fontFamily="@font/poppins_regular"
        android:hint="Password"
        android:inputType="textPassword"
        android:textColorHint="@color/default_blue"
        android:textColor="@color/default_blue"

        android:textSize="16sp"
        android:padding="10dp"



        android:background="@drawable/bg_input_otp"
        app:layout_constraintTop_toBottomOf="@id/EmailInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        >
    </EditText>
    <TextView
        android:id="@+id/forgotPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:fontFamily="@font/poppins_regular"
        android:gravity="right"
        android:text="Forgot Password?"
        android:textColor="@color/black"

        app:layout_constraintTop_toBottomOf="@id/PasswordInput"
        android:layout_marginTop="8dp"
        android:layout_marginRight="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:clickable="true"
        >
    </TextView>
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_regular"
        app:background="@drawable/clickbtn"
        app:backgroundTint="#395886"
        android:textColor="@color/inactive_light_blue"


        app:layout_constraintTop_toBottomOf="@id/forgotPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        />

    <TextView
        android:id="@+id/or"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="or"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/btnContinue"
        android:layout_marginTop="10dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
    </TextView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/BtnGoogle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="@color/btn_account"

        android:text="Continue with google"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/black"

        app:layout_constraintTop_toBottomOf="@id/or"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"

        app:icon="@drawable/icon_google"
        app:iconSize="25dp"
        app:iconTint="@null"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        >

    </com.google.android.material.button.MaterialButton>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/BtnFb"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="@color/btn_account"

        android:text="Continue with Facebook"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/black"

        app:layout_constraintTop_toBottomOf="@id/BtnGoogle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"

        app:icon="@drawable/icon_fb"
        app:iconSize="25dp"
        app:iconTint="@null"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        >

    </com.google.android.material.button.MaterialButton>

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:fontFamily="@font/poppins_regular"

        android:gravity="center"
        android:text="@string/info"
        android:textColor="#757575"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/BtnFb">

    </TextView>
    <TextView
        android:id="@+id/btnsignup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/create"
        android:textColor="@color/black"

        app:layout_constraintTop_toBottomOf="@id/info"
        android:layout_marginTop="50dp"
        android:layout_marginRight="24dp"
        android:layout_marginLeft="24dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

    </TextView>





</androidx.constraintlayout.widget.ConstraintLayout>