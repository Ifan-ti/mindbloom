<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"

    android:layout_height="wrap_content"

    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    app:cardCornerRadius="16dp"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:background="#E1ECF4"
        android:padding="15dp">

        <ImageView
            android:id="@+id/ivArticleImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_app"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/txtJudulArtikel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Judul Artikel Populer yang Sangat Panjang"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#1D3455"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivArticleImage"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/txtDescripsiArtikel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ini adalah ringkasan singkat artikel tersebut..."
            android:maxLines="3"
            android:textSize="12sp"
            android:textColor="#1D3455"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtJudulArtikel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivArticleImage"
            />

        <TextView
            android:id="@+id/txtSelengkapnya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintTop_toBottomOf="@+id/txtDescripsiArtikel"
            app:layout_constraintBottom_toBottomOf="parent"

            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            android:text="Selengkapnya"
            android:textSize="10sp"
            android:textColor="#1D3455"
            />

        <ImageButton
            android:id="@+id/btnNext2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:layout_constraintTop_toTopOf="@+id/txtSelengkapnya"
            app:layout_constraintBottom_toBottomOf="@+id/txtSelengkapnya"
            app:layout_constraintStart_toEndOf="@+id/txtSelengkapnya"
            android:layout_marginStart="5dp"
            android:src="@drawable/btnarrow"
            android:background="@android:color/transparent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>