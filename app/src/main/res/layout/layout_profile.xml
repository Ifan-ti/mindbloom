<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/defaultbackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/button_back"
                    android:minWidth="50dp"
                    android:minHeight="50dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/titleProfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Profil"
                    android:textColor="#395886"
                    android:textSize="23sp"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="26dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/headerProfil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_card"
                    android:paddingStart="20dp"
                    android:paddingTop="56dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mrs. Vante"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnEditProfile"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <ImageButton
                        android:id="@+id/btnEditProfile"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/icon_sharp"
                        app:tint="@android:color/white"
                        tools:ignore="UseAppTint"
                        app:layout_constraintStart_toEndOf="@id/tvName"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvName"
                        app:layout_constraintBottom_toBottomOf="@id/tvName"/>

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="vantekim"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@id/tvName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="You’re growing beautifully"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        app:layout_constraintTop_toBottomOf="@id/tvUsername"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardWriting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/frame_home"
                        android:padding="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvStreakTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keep writing for 1 Day"
                            android:textColor="@color/default_blue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tvDiaryCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="5"
                            android:textColor="@color/default_blue"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/tvStreakTitle"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tvDiaryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="stories...."
                            android:textColor="@color/default_blue"
                            android:textSize="13sp"
                            android:layout_marginStart="4dp"
                            app:layout_constraintStart_toEndOf="@id/tvDiaryCount"
                            app:layout_constraintBaseline_toBaselineOf="@id/tvDiaryCount"/>

                        <TextView
                            android:id="@+id/tvDiaryQuote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="ADiary Mean Yes Indeed"
                            android:textColor="@color/default_blue"
                            android:textSize="14sp"
                            android:textStyle="italic"
                            app:layout_constraintTop_toBottomOf="@id/tvDiaryCount"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardAverageMood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/frame_home"
                        android:padding="16dp"
                        app:layout_constraintTop_toBottomOf="@id/cardWriting"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvMoodTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Average Mood"
                            android:textColor="@color/default_blue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tvMoodSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="How does your mood change"
                            android:textColor="@color/default_blue"
                            android:textSize="12sp"

                            app:layout_constraintTop_toBottomOf="@id/tvMoodTitle"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/moodChart"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/tvMoodSubtitle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"
                        app:layout_constraintStart_toStartOf="@id/cardHeader"
                        app:layout_constraintEnd_toEndOf="@id/cardHeader"
                        app:layout_constraintTop_toBottomOf="@id/cardAverageMood"
                        >
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_seetting"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"

                            android:background="@drawable/clickbtn"
                            app:backgroundTint="@color/inactive_light_blue"

                            android:text="Setting"
                            android:textColor="@color/default_blue"
                            android:textAllCaps="false"
                            android:gravity="left"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:letterSpacing="0"

                            app:icon="@drawable/icon_setting"
                            app:iconTint="@color/default_blue"


                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_logout"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"

                            android:background="@drawable/clickbtn"
                            app:backgroundTint="@color/inactive_light_blue"

                            android:text="Log Out"
                            android:textColor="@color/default_blue"
                            android:textAllCaps="false"
                            android:gravity="left"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:letterSpacing="0"

                            app:icon="@drawable/icon_logout"
                            app:iconTint="@color/default_blue"
                            android:layout_marginTop="5dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/btn_seetting"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/bg_Avatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:background="@drawable/bg_rounded"
                    android:scaleType="centerCrop"
                    android:translationY="-30dp"
                    android:elevation="10dp"
                    app:layout_constraintTop_toTopOf="@id/cardHeader"
                    app:layout_constraintStart_toStartOf="@id/cardHeader"
                    app:layout_constraintEnd_toEndOf="@id/cardHeader"
                    app:shapeAppearanceOverlay="@style/CircleStyle"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:background="@drawable/bg_rounded"
                    android:scaleType="centerCrop"
                    android:translationY="-25dp"
                    android:elevation="11dp"
                    app:layout_constraintTop_toTopOf="@id/cardHeader"
                    app:layout_constraintStart_toStartOf="@id/cardHeader"
                    app:layout_constraintEnd_toEndOf="@id/cardHeader"
                    app:shapeAppearanceOverlay="@style/CircleStyle"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:paddingHorizontal="10dp"
        android:background="@drawable/bg_navbar_float"
        android:backgroundTint="#F0F3FA"
        android:elevation="12dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/nav_home_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navPeople"/>

        <ImageButton
            android:id="@+id/navPeople"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/nav_people_icon"
            android:background="@android:color/transparent"
            android:contentDescription="People"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/navHome"
            app:layout_constraintEnd_toStartOf="@id/nav_diary"/>

        <ImageButton
            android:id="@+id/nav_diary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/nav_articles_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Diary"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/navPeople"
            app:layout_constraintEnd_toStartOf="@id/navChat"/>

        <ImageButton
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/nav_chat_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Chat"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/nav_diary"
            app:layout_constraintEnd_toStartOf="@id/navProfile"/>

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/nav_profile_icon"
            app:tint="@color/active_btn"
            android:background="@android:color/transparent"
            android:contentDescription="Profile"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/navChat"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>