<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/defaultbackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- HEADER ATAS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerProfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textSize="23sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="65dp"
            android:layout_height="70dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/button_back"
            android:minWidth="50dp"
            android:minHeight="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/titleProfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Profil"
            android:textColor="#395886"
            android:textSize="23sp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- KONTEN PROFIL (KARTU BESAR) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerProfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar">


    <!-- CARD BIRU -->

        <!-- AVATAR YANG NGE-OVERLAP DI ATAS CARD -->
        <LinearLayout
            android:id="@+id/cardHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="56dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- NAMA + ICON EDIT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mrs. Vante"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/icon_sharp"
                    app:tint="@android:color/white"
                    tools:ignore="UseAppTint" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="vantekim"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="You’re growing beautifully"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <!-- CARD WRITING -->
            <LinearLayout
                android:id="@+id/cardWriting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/frame_home"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStreakTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep writing for 1 Day"
                    android:textColor="@color/default_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiaryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="5"
                    android:textColor="@color/default_blue"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="stories...."
                    android:textColor="@color/default_blue"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDiaryQuote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ADiary Mean Yes Indeed"
                    android:textColor="@color/default_blue"
                    android:textSize="14sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- CARD AVERAGE MOOD -->
            <LinearLayout
                android:id="@+id/cardAverageMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/frame_home"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvMoodTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average Mood"
                    android:textColor="@color/default_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMoodSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="How does your mood change"
                    android:textColor="@color/default_blue"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/imgMoodChart"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="16dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/bg_round"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="@id/cardHeader"
            app:layout_constraintStart_toStartOf="@id/cardHeader"
            app:layout_constraintEnd_toEndOf="@id/cardHeader"
            android:translationY="-25dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BOTTOM NAV BAR (tetap sama) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:background="@drawable/bg_navbar_float"
        android:backgroundTint="#F0F3FA"
        android:elevation="2dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/nav_home_icon"
            android:background="@android:color/transparent"
            app:tint="@color/inactive_btn"
            android:contentDescription="People"

            />
        <ImageButton
            android:id="@+id/navPeople"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/nav_people_icon"
            android:background="@android:color/transparent"
            android:contentDescription="People" />

        <ImageButton
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/nav_articles_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Calendar" />

        <ImageButton
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/nav_chat_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Chat" />

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/nav_profile_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Profile" />
        ...
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
