<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp">

    <!-- Titik merah -->
    <View
        android:id="@+id/viewDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:backgroundTint="#FF3B30"
        android:background="@drawable/bg_dot_red"
        app:layout_constraintTop_toTopOf="@+id/imgProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintMarginStart="4dp"
        app:layout_constraintMarginTop="8dp"/>

    <!-- Foto profil -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_profile_placeholder"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_bg_gray"
        app:layout_constraintStart_toEndOf="@+id/viewDot"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nama dan waktu -->
    <TextView
        android:id="@+id/tvNama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anonimus"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/imgProfile"
        app:layout_constraintTop_toTopOf="@+id/imgProfile"
        app:layout_constraintMarginStart="8dp" />

    <TextView
        android:id="@+id/tvWaktu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 jam"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/tvNama"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvNama"
        app:layout_constraintMarginStart="8dp" />

    <!-- Deskripsi aksi -->
    <TextView
        android:id="@+id/tvdesk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Memberikan komentar"
        android:textColor="#444444"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/tvNama"
        app:layout_constraintTop_toBottomOf="@+id/tvNama"
        app:layout_constraintMarginTop="2dp" />

    <!-- Pesan komentar -->
    <TextView
        android:id="@+id/tvKomentar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Semangat Kakk"
        android:textColor="#888888"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@+id/tvdesk"
        app:layout_constraintTop_toBottomOf="@+id/tvdesk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintMarginTop="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
