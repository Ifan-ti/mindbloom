<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"

        android:background="@drawable/frame_home"
        >

        <ImageView
            android:id="@+id/img_profile"
            android:layout_width="100dp"
            android:layout_height="100dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"


            android:src="@drawable/moodhappy"
            />

        <TextView
            android:id="@+id/txtUsernmae"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toTopOf="@id/img_profile"
            app:layout_constraintStart_toEndOf="@id/img_profile"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="20dp"

            android:text="Dr. Agha"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/default_blue"
            />
        <TextView
            android:id="@+id/txtJob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toBottomOf="@id/txtUsernmae"
            app:layout_constraintStart_toStartOf="@id/txtUsernmae"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="20dp"

            android:text="Psikolog"
            android:textColor="#616B7E"
            android:textSize="12sp"
            />
        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toBottomOf="@id/txtJob"
            app:layout_constraintStart_toStartOf="@id/txtUsernmae"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"

            android:paddingStart="4dp"
            android:paddingEnd="4dp"


            android:text="5 Tahun"
            android:textSize="12sp"
            android:textColor="#616B7E"
            android:background="@drawable/bg_exp"
            android:backgroundTint="#B0C2E5"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="60dp"
            android:layout_height="30dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"

            android:text="Chat"
            android:textAllCaps="false"
            android:textStyle="normal"
            android:textSize="8sp"



            android:background="@drawable/bg_input_otp"
            app:backgroundTint="#628ECD"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>