<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/viewFilterApproved"
        android:layout_width="120dp"
        android:layout_height="40dp"

        android:background="@drawable/frame_home"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/tvFilterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toTopOf="@id/viewFilterApproved"
        app:layout_constraintStart_toStartOf="@id/viewFilterApproved"
        app:layout_constraintBottom_toBottomOf="@id/viewFilterApproved"
        app:layout_constraintEnd_toEndOf="@id/viewFilterApproved"

        android:text="Filter Title"
        android:textColor="@color/default_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        />


</androidx.constraintlayout.widget.ConstraintLayout>