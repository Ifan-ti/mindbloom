<resources>

<style name="RoundedTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
    <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.CornerRadius</item>
</style>

<style name="ShapeAppearance.App.CornerRadius" parent="">
<item name="cornerFamily">rounded</item>
<item name="cornerSize">20dp</item>
</style>

    <style name="CustomRadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/radio_option</item>
        <item name="android:buttonTint">#2E4A7B</item>
        <item name="android:textColor">#2E3A59</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="CircleStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="CustomRoundedDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/frame_home</item>
        <item name="colorPrimary">@color/default_blue</item>

    </style>

    
</resources>
