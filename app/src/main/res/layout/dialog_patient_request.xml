<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    android:backgroundTint="#E8EEF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pasient Request"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3B5270"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User Melakukan Request Konsultasi"
            android:textSize="16sp"
            android:textColor="#5E7A9B"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="32dp"/>

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:weightSum="2">

            <!-- Button Tolak (Outlined) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Tolak"
                android:textSize="16sp"
                android:textColor="#6B88AB"
                app:strokeColor="#6B88AB"
                app:strokeWidth="2dp"
                app:cornerRadius="12dp"
                android:layout_marginEnd="12dp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"/>

            <!-- Button Chat (Filled) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Setuju"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#6B88AB"
                app:cornerRadius="12dp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>