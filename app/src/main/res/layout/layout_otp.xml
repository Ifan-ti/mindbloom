<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/inactive_light_blue"

    >

    <ImageView
        android:id="@+id/logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp"
        android:src="@drawable/icon_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_signup_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Verification"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txt_signup_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="Enter 6-digit code sent to your email"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- OTP Input 1 -->
    <EditText
        android:id="@+id/input_1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/input_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        android:textColor="@color/default_blue"
        />

    <!-- OTP Input 2 -->
    <EditText
        android:id="@+id/input_2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        app:layout_constraintStart_toEndOf="@+id/input_1"
        app:layout_constraintEnd_toStartOf="@+id/input_3"
        android:textColor="@color/default_blue"
        />

    <!-- OTP Input 3 -->
    <EditText
        android:id="@+id/input_3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toEndOf="@+id/input_2"
        app:layout_constraintEnd_toStartOf="@+id/input_4"
        android:textColor="@color/default_blue"
        />

    <!-- OTP Input 4 -->
    <EditText
        android:id="@+id/input_4"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toEndOf="@+id/input_3"
        app:layout_constraintEnd_toStartOf="@+id/input_5"
        android:textColor="@color/default_blue"
        />

    <!-- OTP Input 5 -->
    <EditText
        android:id="@+id/input_5"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toEndOf="@+id/input_4"
        app:layout_constraintEnd_toStartOf="@+id/input_6"
        android:textColor="@color/default_blue"
        />

    <!-- OTP Input 6 -->
    <EditText
        android:id="@+id/input_6"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:background="@drawable/bg_input_otp"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txt_signup_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toEndOf="@+id/input_5"
        android:textColor="@color/default_blue"
        />

    <!-- Timer Display -->
    <TextView
        android:id="@+id/txt_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01:00"
        android:textColor="@color/default_blue"
        android:fontFamily="@font/poppins_bold"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/input_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Resend OTP -->
    <TextView
        android:id="@+id/txt_resend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend OTP"
        android:textColor="@color/default_blue"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/txt_timer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Verify OTP"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_regular"
        app:layout_constraintTop_toBottomOf="@id/txt_resend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"

        app:background="@drawable/clickbtn"
        app:backgroundTint="#395886"

        android:textColor="@color/inactive_light_blue"

        />

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/info"
        android:textColor="#757575"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnContinue" />
</androidx.constraintlayout.widget.ConstraintLayout>