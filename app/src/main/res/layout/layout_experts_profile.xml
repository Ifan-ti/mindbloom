<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:background="@color/defaultbackground"

    >

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"

        android:src="@drawable/button_back"
        android:background="@android:color/transparent"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutBlue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"

        android:background="@drawable/bg_profile_card"
        android:paddingBottom="20dp"
        >
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mrs. Vante"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="50dp"
            />
        <TextView
            android:id="@+id/tvJob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konselor"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detail_experts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toBottomOf="@id/tvJob"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="10dp"

            android:background="@drawable/clickbtn"
            android:backgroundTint="#D5DEEF"
            >
            <TextView
                android:id="@+id/txtBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"

                android:text="BIo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/default_blue"
                />
            <TextView
                android:id="@+id/tvBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:layout_constraintTop_toBottomOf="@id/txtBio"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="3dp"

                android:text="Aku Sanagt Kuat"
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/default_blue"
                />
            <TextView
                android:id="@+id/txtLicenseNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                app:layout_constraintTop_toBottomOf="@id/tvBio"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"

                android:text="License Number"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/default_blue"
                />
            <TextView
                android:id="@+id/tvLicenseNum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:layout_constraintTop_toBottomOf="@id/txtLicenseNum"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="20sp"


                android:text="Aku Sanagt Kuat"
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/default_blue"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:id="@+id/btnChat"
            android:layout_width="match_parent"
            android:layout_height="40dp"

            app:layout_constraintTop_toBottomOf="@id/detail_experts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"

            android:background="@drawable/clickbtn"
            app:backgroundTint="#D5DEEF"

            android:text="Chat"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="@color/default_blue"

            />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bg_Avatar"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@drawable/bg_rounded"
        android:scaleType="centerCrop"
        android:elevation="10dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/constraintLayoutBlue"

        app:layout_constraintBottom_toTopOf="@id/constraintLayoutBlue"

        app:shapeAppearanceOverlay="@style/CircleStyle"
        />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatarDetail"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@drawable/bg_rounded"
        android:scaleType="centerCrop"
        android:elevation="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/constraintLayoutBlue"
        app:layout_constraintBottom_toTopOf="@id/constraintLayoutBlue"

        app:shapeAppearanceOverlay="@style/CircleStyle"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:paddingHorizontal="10dp"
        android:background="@drawable/bg_navbar_float"
        android:backgroundTint="#F0F3FA"
        android:elevation="12dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/nav_chat_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Chat"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navProfile"/>

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/nav_profile_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Profile"
            app:layout_constraintHorizontal_weight="1"
            app:tint="@color/active_btn"
            app:layout_constraintStart_toEndOf="@id/navChat"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>





</androidx.constraintlayout.widget.ConstraintLayout>