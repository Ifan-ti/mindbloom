<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    app:cardCornerRadius="16dp"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#E1ECF4"
        >

        <ImageView
            android:id="@+id/ivArticleImageArticles"
            android:layout_width="150dp"
            android:layout_height="0dp"
            android:background="@drawable/image_rounded_corner"
            android:clipToOutline="true"
            android:foreground="@drawable/gradient_overlay"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:id="@+id/ivArticleImageDiary"
            android:layout_width="150dp"
            android:layout_height="0dp"
            android:background="@drawable/image_rounded_corner"
            android:clipToOutline="true"
            android:foreground="@drawable/gradient_overlay"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_marginEnd="15dp"
            android:visibility="gone"
            />

        <TextView
            android:id="@+id/txtJudulArtikel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Judul Artikel Populer yang Sangat Panjang"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1D3455"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivArticleImageArticles"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            />

        <TextView
            android:id="@+id/txtDescripsiArtikel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ini adalah ringkasan singkat artikel tersebut. Baca selengkapnya untuk mendapatkan informasi yang lengkap."
            android:maxLines="3"
            android:textSize="12sp"
            android:textColor="#1D3455"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"

            app:layout_constraintTop_toBottomOf="@id/txtJudulArtikel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivArticleImageArticles"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0"
            android:layout_marginStart="15dp"

            />

        <TextView
            android:id="@+id/txtSelengkapnya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"

            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"

            android:text="Selengkapnya"
            android:textColor="#1D3455"
            android:textSize="10sp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtDescripsiArtikel"

            />
        <ImageButton
            android:id="@+id/btnNext2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:layout_constraintTop_toTopOf="@+id/txtSelengkapnya"
            app:layout_constraintStart_toEndOf="@+id/txtSelengkapnya"
            android:layout_marginStart="5dp"
            android:src="@drawable/btnarrow"
            android:background="@android:color/transparent"


            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>